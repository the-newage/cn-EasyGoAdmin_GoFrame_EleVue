# ============================================================
# .dockerignore —— Docker 构建上下文排除清单
# 位置约定：必须位于构建上下文根目录（项目根），与 docker/Dockerfile 位置无关
# ============================================================

# 版本控制与 IDE
.git
.gitignore
.idea
.vscode
.claude

# 前端（独立部署，不进后端镜像）
/ui

# 构建产物与本地运行痕迹
/bin
/log
/upload

# Docker 自身配置（不参与镜像构建）
/docker
/.jenkins

# 开发/文档资产，运行时不需要
/document
/hack
*.md
Makefile

# 本地敏感/临时文件
.env
*.exe
*.db
